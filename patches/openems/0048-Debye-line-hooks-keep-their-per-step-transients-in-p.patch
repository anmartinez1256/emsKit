+		for (size_t g=0; g<groups; ++g)   // forward: a block's W moves down, never onto a block that has not moved yet
+			memmove(blk + g*ws, blk + g*bs, ws*sizeof(float));
+	else
+		for (size_t g=groups; g-->0; )    // backward; the transients are dead between two runs of timesteps: zero
+		{
+			memmove(blk + g*bs, blk + g*ws, ws*sizeof(float));
+			std::fill(blk + g*bs + ws, blk + (g+1)*bs, 0.0f);
+		}
+	m_WStride = (unsigned int)(rangeLocal ? ws : bs);
