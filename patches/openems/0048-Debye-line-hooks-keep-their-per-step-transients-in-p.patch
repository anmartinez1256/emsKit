+void Engine_Ext_DebyeMaterial::SetRangeLocal(bool granted, unsigned int lines, unsigned int threads)
+{
+	if (!m_Packed)
+		return;
+	std::string why;
+	if (ScratchOff())
+		why = "OPENEMS_ADE_SCRATCH=0";
+	else if (!granted || (lines==0) || (threads==0))
+		why = "not granted by the engine's plan";
+	const size_t groups = m_GroupX.size();
+	size_t most = 0, slice = 0;
+	if (why.empty())
+	{
+		// the most groups a range of `lines` x-lines can hold (m_GroupX ascending): every range [x0, x0+lines) holds at most
+		// the groups from its first one on that lie within `lines` x-lines of it
+		for (size_t a=0, b=0; a<groups; ++a)
+		{
+			const uint64_t end = (uint64_t)m_GroupX[a] + lines;
+			b = std::max(a, b);
+			while ((b<groups) && (m_GroupX[b]<end))
+				++b;
+			most = std::max(most, b-a);
+		}
+		slice = std::max((size_t)64, (24*most+63) & ~(size_t)63);   // floats a thread, a multiple of 256 B
+		try
+		{
+			std::vector<float>((size_t)threads*slice, 0.0f).swap(m_Scratch);
+			std::vector<unsigned int>((size_t)threads*32, 0u).swap(m_ScratchHdr);
+		}
+		catch (std::bad_alloc&)
+		{
+			why = "the scratch could not be allocated";
+		}
+	}
+	const bool on = why.empty();
+	if (on!=m_RangeLocal)
+		Relayout(on);
+	m_RangeLocal = on;
+	if (on)
+	{
+		m_ScratchSlice = slice;
+		m_ScratchLines = lines;
+		m_ScratchThreads = threads;
+	}
+	else
+	{
+		std::vector<float>().swap(m_Scratch);
+		std::vector<unsigned int>().swap(m_ScratchHdr);
+		m_ScratchSlice = 0;
+		m_ScratchLines = m_ScratchThreads = 0;
+	}
+	if (g_settings.GetVerboseLevel()>1)
+	{
+		std::ostringstream o;
+		if (on)
+			o << "range-local transients on (blocks of W only, " << m_WStride << " of " << m_BlockStride << " floats a group; pre and correction in "
+			  << "a scratch of up to " << most << " groups a thread for ranges of up to " << lines << " x-lines, " << threads << " x "
+			  << slice*sizeof(float)/1024.0 << " KiB)";
+		else
+			o << "range-local transients off (stored blocks, " << m_BlockStride << " floats a group: " << why << ")";
+		if (o.str()!=m_RangeMsg)
+			std::cout << GetExtensionName() << ": " << o.str() << std::endl;
+		m_RangeMsg = o.str();
+	}
