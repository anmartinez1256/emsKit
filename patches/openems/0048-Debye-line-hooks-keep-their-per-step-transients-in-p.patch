+void Engine_Ext_DebyeMaterial::Relayout(bool rangeLocal)
+{
+	const size_t groups = m_GroupX.size();
+	const size_t bs = m_BlockStride, ws = 12*(size_t)m_Op_Ext_Deb->m_PoleCount;
