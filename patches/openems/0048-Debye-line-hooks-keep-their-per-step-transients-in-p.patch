+	if ((x1<x0) || (x1-x0>m_ScratchLines))
+		RangeFault(GetExtensionName(), "a range wider than the grant", hook, t, x0, x1, y0, y1);
+	// Pre needs no open range, Post the range of the Pre before it, Apply the range of the Post before it
+	unsigned int* h = &m_ScratchHdr[(size_t)t*32];
+	if ((h[0]!=(unsigned int)hook) || ((hook>0) && ((h[1]!=x0) || (h[2]!=x1) || (h[3]!=y0) || (h[4]!=y1))))
+		RangeFault(GetExtensionName(), hook==0 ? "a Pre hook before the Apply hook of the range before" : "not the range of the Pre hook before",
+				   hook, t, x0, x1, y0, y1);
+	h[0] = (hook==2) ? 0 : (unsigned int)hook+1;
+	h[1] = x0; h[2] = x1; h[3] = y0; h[4] = y1;
