+void Engine_Multithread::GrantRangeLocal()
+{
+	// Which drivers call the hook triple Pre, Post, Apply of one range back to back on one thread (Engine_Extension::
+	// SetRangeLocal), by the plan SetupFused() just built:
+	//  - unfused plan (RunHooks): whole-grid hooks (on thread 0 for the dispersive extensions) -> no;
+	//  - fused sweep without y-bands (FusedTimestep, FusedTimestepFlags): per x-line block FusedHooks(0), the update,
+	//    FusedHooks(1), FusedHooks(2), then the currents of the lines behind it (FusedCurrents: Pre, update, Post, Apply of
+	//    their range, as is the line before the slab after the sweep) -> yes, ranges = the blocks;
+	//  - y-bands (FusedBands): per band and block RunBoxHooks(0), update, (1), (2) on the band's box, then the same for
+	//    the currents' box; the last block(s) of a slab in whole planes through FusedHooks -> yes; but with a closed y
+	//    direction the last band calls RunBoxHooks2 (Pre of two boxes, then Post of both, then Apply of both) -> no;
+	//  - tiled sweep in box mode (TiledRun): per task Pre, update, Post, Apply of the thread's box -> yes, ranges = tasks;
+	//  - tiled sweep with hook stages: Post and Apply of a task and Pre of the next one in other shares -> no.
+	std::string why;
+	unsigned int lines = 0;
+	if (!m_Fused)
+		why = "no fused sweep, whole-grid hooks";
+	else if (m_Tiled && !m_TileBox)
+		why = "the tiled sweep's hook stages";
+	else if (m_Tiled)
+	{
+		for (size_t d=0; d<m_TilePlan.size(); ++d)
+			for (size_t i=0; i<m_TilePlan[d].size(); ++i)
+				lines = std::max(lines, m_TilePlan[d][i].x1-m_TilePlan[d][i].x0);
+	}
+	else if (m_YBand && m_YWrap)
+		why = "y-bands of a closed y direction, two boxes per hook in the last band";
+	else
+		for (size_t b=0; b+1<m_Blocks.size(); ++b)
+			lines = std::max(lines, m_Blocks[b+1]-m_Blocks[b]);
+	if (why.empty() && (lines==0))
+		why = "no ranges";
+	m_RangeLocal = why.empty();
+	m_RangeLocalLines = m_RangeLocal ? lines : 0;
+	m_RangeLocalOn = m_RangeLocal;
+	const char* env = getenv("OPENEMS_ADE_SCRATCH");
+	m_RangeLocalAlt = env && (strcmp(env, "alt")==0);
+	bool any = false;
+	for (size_t k=0; k<m_Eng_exts.size(); ++k)
+	{
+		const unsigned int used = m_Eng_exts.at(k)->GetUsedHooks();
+		any = any || ((used!=Engine_Extension::LEGACY_HOOKS) && (used & Engine_Extension::RANGE_LOCAL));
+	}
+	const std::string msg = !any ? "" : (m_RangeLocal ? "range-local hooks granted (ranges of up to " + std::to_string(lines) + " x-lines" +
+					  (m_RangeLocalAlt ? ", withdrawn and granted again before every run: OPENEMS_ADE_SCRATCH=alt)" : ")")
+					: "range-local hooks not granted (" + why + ")");
+	if (!msg.empty() && (msg!=m_RangeLocalMsg) && (g_settings.GetVerboseLevel()>1))
+		cout << "Multithreaded engine: " << msg << endl;
+	m_RangeLocalMsg = msg;
+	TellRangeLocal();
+}
+
+void Engine_Multithread::TellRangeLocal()
+{
+	for (size_t k=0; k<m_Eng_exts.size(); ++k)
+	{
+		Engine_Extension* ext = m_Eng_exts.at(k);
+		const unsigned int used = ext->GetUsedHooks();
+		if ((used!=Engine_Extension::LEGACY_HOOKS) && (used & Engine_Extension::RANGE_LOCAL))
+			ext->SetRangeLocal(m_RangeLocalOn, m_RangeLocalOn ? m_RangeLocalLines : 0, m_numThreads);
+	}
 }
 
