+			// union of its ranges (a mountain stays in [lo, hi), a valley in [lo-K, hi+K)), in entry order
+			auto lists = [&](const std::vector<uint32_t>& ent, size_t stride, std::vector<uint32_t>& off, std::vector<uint32_t>& list)
