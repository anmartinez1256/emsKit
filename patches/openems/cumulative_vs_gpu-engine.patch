+							const int y0 = t[2+yt][2*ty] - (yt ? (int)c.K : 0), y1 = t[2+yt][2*ty+1] + (yt ? (int)c.K : 0);
+							for (size_t k=0; k<count; ++k)
+							{
+								const int x = ent[stride*k], y = ent[stride*k+1];
+								if ((x>=x0) && (x<x1) && (y>=y0) && (y<y1))
