+		case 2: exts[n]->Apply2VoltagesLines(x0, x1); break;
+		case 3: exts[n]->DoPreCurrentUpdatesLines(x0, x1); break;
+		case 4: exts[n]->DoPostCurrentUpdatesLines(x0, x1); break;
