+//! lanes of a where the mask is set, lanes of b elsewhere
+static inline v4sf UPML_Blend(const v4sf m, const v4sf a, const v4sf b)
+{
+	return (v4sf)(((UPML_v4si)a & (UPML_v4si)m) | ((UPML_v4si)b & ~(UPML_v4si)m));
