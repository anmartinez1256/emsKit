+//! the performance cores of an Apple CPU (hw.perflevel0), 0 elsewhere or when unknown
+static unsigned int PerformanceCores()
+{
+#ifdef __APPLE__
+	int pcores = 0;
+	size_t len = sizeof(pcores);
+	if ((sysctlbyname("hw.perflevel0.physicalcpu", &pcores, &len, NULL, 0)==0) && (pcores>0))
+		return pcores;
+#endif
+	return 0;
+}
+
+//! the cores of an Apple CPU outside its efficiency cluster: every hw.perflevelN whose name is not "Efficiency"
+//! (an M5: the 4 "Super" cores; an M5 Pro: 5 "Super" + 10 "Performance"); 0 elsewhere or when unknown
+static unsigned int NonEfficiencyCores()
+{
+#ifdef __APPLE__
+	int levels = 0;
+	size_t len = sizeof(levels);
+	if ((sysctlbyname("hw.nperflevels", &levels, &len, NULL, 0)!=0) || (levels<1))
+		return 0;
+	unsigned int sum = 0;
+	for (int k=0; k<levels; ++k)
+	{
+		char key[64], name[64] = {0};
+		snprintf(key, sizeof(key), "hw.perflevel%d.name", k);
+		len = sizeof(name)-1;
+		if (sysctlbyname(key, name, &len, NULL, 0)!=0)
+			return 0;
+		if (strcmp(name, "Efficiency")==0)
+			continue;
+		int cores = 0;
+		snprintf(key, sizeof(key), "hw.perflevel%d.physicalcpu", k);
+		len = sizeof(cores);
+		if ((sysctlbyname(key, &cores, &len, NULL, 0)!=0) || (cores<1))
+			return 0;
+		sum += cores;
+	}
+	return sum;
+#else
+	return 0;
+#endif
+}
+
+//! the tuner's start rule: OPENEMS_TUNE_START=p is the rule up to patch 0040 (start at hw.perflevel0, search
+//! upwards in steps of 2, one step down); unset or anything else starts at every core outside the efficiency
+//! cluster and steps down by 2 for as long as that is faster
+static bool TuneStartAtPerflevel0()
+{
+	const char* env = getenv("OPENEMS_TUNE_START");
+	return env && (strcmp(env, "p")==0);
+}
+
+//! first thread count of the automatic search: the cores outside the efficiency cluster (Apple; with
+//! OPENEMS_TUNE_START=p the performance cores of hw.perflevel0), else half the hardware threads
+static unsigned int StartThreads(unsigned int maxThreads)
+{
+	unsigned int n = TuneStartAtPerflevel0() ? 0 : NonEfficiencyCores();
+	if (n==0)
+		n = PerformanceCores();
+	if (n==0)
+		n = (maxThreads+1)/2;
+	return std::max(1u, std::min(n, maxThreads));
+}
+
+//! The cache one tile of the tiled sweep should fit (OPENEMS_TBLOCK=auto): the L2 cache that the performance cores
+//! of an Apple CPU share (hw.perflevel0.l2cachesize), elsewhere the last-level cache when the C library reports
+//! it; 0 when unknown
+static size_t TileCacheBytes()
+{
+#ifdef __APPLE__
+	const char* names[2] = {"hw.perflevel0.l2cachesize", "hw.l3cachesize"};
+	for (int k=0; k<2; ++k)
+	{
+		int64_t bytes = 0;   // the kernel fills 4 or 8 of these bytes
+		size_t len = sizeof(bytes);
+		if ((sysctlbyname(names[k], &bytes, &len, NULL, 0)==0) && (bytes>0))
+			return (size_t)bytes;
+	}
+#elif defined(_SC_LEVEL3_CACHE_SIZE)
+	long bytes = sysconf(_SC_LEVEL3_CACHE_SIZE);
+	if (bytes<=0)
+		bytes = sysconf(_SC_LEVEL2_CACHE_SIZE);
+	if (bytes>0)
+		return (size_t)bytes;
+#endif
+	return 0;
+}
+
+//! How long a wait for a neighbour flag spins before it sleeps (StepFlag::WaitFor): OPENEMS_FLAGS_SPIN_US for any
+//! thread count; else none when the threads outnumber the performance cores of an Apple CPU (some of them run on the
+//! efficiency cores, the waits for them are long, and a spinning thread only takes power and a core from the others),
+//! and SpinBarrier's spin time (OPENEMS_BARRIER_SPIN_US, default 50 us) up to that count and on other CPUs.
