+void Engine_Ext_LumpedRLC::SetSlots(FDTD_FLOAT** c, FDTD_FLOAT* const* base, unsigned int ts)
+{
+	// rotated once at the start of every timestep: c[2] = c[1], c[1] = c[0], c[0] = the old c[2]
