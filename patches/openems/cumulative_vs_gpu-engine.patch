+    v = volt[I(1,x,y,zv,d)]; v = v * c[2]; v = fma(c[3], ((c0 - c0zm) - c2) + c2xm, v); volt[I(1,x,y,zv,d)] = v;
+    v = volt[I(2,x,y,zv,d)]; v = v * c[4]; v = fma(c[5], ((c1 - c1xm) - c0) + c0ym, v); volt[I(2,x,y,zv,d)] = v;
+#endif
+}
