+			State::Tiling c;
+			c.K = kmv[0];
+			c.M = kmv[1];
+			c.V = kmv[2];
+			std::vector<int32_t> t[4];
+			DiamondTiles(numLines[0], c.M, c.V, c.K, t[0], t[1]);
