+        const uint zq = zv > 0 ? zv-1 : d.nv-1;
+        const float4 a = curr[I(1,x,y,zq,d)], b = curr[I(0,x,y,zq,d)];
+        c1zm = zv > 0 ? a : float4(0.0f, a.x, a.y, a.z);
