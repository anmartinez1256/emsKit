+			if (timedPhase[n]>=0)
+				md.phaseSec[timedPhase[n]] += g;
+			first = (n==0) ? b.GPUStartTime : std::min(first, b.GPUStartTime);
+			last = std::max(last, b.GPUEndTime);
+		}
+		md.gpuSpan += last - first;
+		md.cbs += timed.count;
+	}
+	++md.calls;
+	return true;
+}
