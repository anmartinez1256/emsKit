+void Engine_Ext_LumpedRLC::DoPreVoltageUpdatesBox(unsigned int x0, unsigned int x1, unsigned int y0, unsigned int y1)
+{
+	if (!m_Op_Ext_RLC->RLC_count || (y0>=y1))
+		return;
+	FDTD_FLOAT* vd[3];
+	SetSlots(vd, m_VdBase, m_Eng->GetNumberOfTimesteps());
+	unsigned int n0, n1;
+	LineRange(x0, x1, n0, n1);
+	if (n0>=n1)
+		return;
+	const std::vector<unsigned int>& list = BoxOrder(n0, n1, y0, y1);
+	UpdateInductorCurrents(vd[1], list.data(), 0, list.size());
+}
+
+void Engine_Ext_LumpedRLC::Apply2VoltagesBox(unsigned int x0, unsigned int x1, unsigned int y0, unsigned int y1)
+{
+	if (!m_Op_Ext_RLC->RLC_count || (y0>=y1))
+		return;
+	const unsigned int ts = m_Eng->GetNumberOfTimesteps();
+	FDTD_FLOAT* vd[3];
+	FDTD_FLOAT* j[3];
+	SetSlots(vd, m_VdBase, ts);
+	SetSlots(j, m_JBase, ts);
+	unsigned int n0, n1;
+	LineRange(x0, x1, n0, n1);
+	if (n0>=n1)
+		return;
+	const std::vector<unsigned int>& list = BoxOrder(n0, n1, y0, y1);
+	if (!list.empty())
+		Apply2VoltagesImpl<Engine_sse>((Engine_sse*)m_Eng, vd, j, list.data(), 0, list.size());
+}
