+#ifdef UPML_F4VECTOR
+template <int HOOK>
+void Engine_Ext_UPML::YVecPart(unsigned int lx, unsigned int g, unsigned int l0, unsigned int l1)
+{
+	// YVecRows for the lanes [l0, l1) of one group: the other lanes belong to another thread's y range, so they are
+	// neither read nor written here (their fields and fluxes may change meanwhile). A whole group takes the vector
+	// operations of YVecRows with zeros in the other lanes (every lane on its own: the lanes inside get the operands
+	// and results of the whole group), a short group the lane by lane code of YVecRows.
+	Engine_sse* eng = (Engine_sse*)m_Eng;
+	ArrayLib::ArrayENG<f4vector>* A = (HOOK<2) ? eng->f4_volt_ptr : eng->f4_curr_ptr;
+	float* __restrict field = (float*)A->data();
+	const size_t sx = 4*A->stride(1), sy = 4*A->stride(2);
+	const unsigned int NY = m_Op_UPML->m_numLines[1], NZ = m_Op_UPML->m_numLines[2], NG = m_NG;
+	const unsigned int* __restrict zo = m_zoff.data();
+	const Coef4* __restrict tab = m_CoefTabY.data();
+	f4vector* __restrict fluxes = (HOOK<2) ? m_y_volt_flux.data() : m_y_curr_flux.data();
+	const unsigned int ly = 4*g, lanes = std::min(4u, NY-ly);
+	l1 = std::min(l1, lanes);
+	if (l0>=l1)
+		return;
+	float* __restrict e = field + (lx + m_Op_UPML->m_StartPos[0])*sx + (ly + m_Op_UPML->m_StartPos[1])*sy;
+	for (unsigned int n=0; n<3; ++n)
+	{
+		const size_t b = (((size_t)lx*NG+g)*3+n)*NZ;
+		f4vector* __restrict flux = fluxes + b;
+		const unsigned int* __restrict ix = m_CoefIdxY.data() + b;
+		float* __restrict e0 = e + 4*n;
+		if (lanes==4)
+		{
+			for (unsigned int lz=0; lz<NZ; ++lz)
+			{
+				const unsigned int o = zo[lz];
+				const Coef4& c = tab[ix[lz]];
+				v4sf E = {0, 0, 0, 0};
+				v4sf F = {0, 0, 0, 0};
+				for (unsigned int l=l0; l<l1; ++l)
+				{
+					E[l] = e0[l*sy+o];
+					F[l] = flux[lz].f[l];
+				}
+				v4sf En, Fn;
+				if ((HOOK==0) || (HOOK==2))
+				{
+					const v4sf p = -(((HOOK==0) ? c.vvfo.v : c.iifo.v) * F);
+					Fn = ((HOOK==0) ? c.vv.v : c.ii.v) * E + p;
+					En = F;
+				}
+				else
+				{
+					En = F + ((HOOK==1) ? c.vvfn.v : c.iifn.v) * E;
+					Fn = E;
+				}
+				for (unsigned int l=l0; l<l1; ++l)
+				{
+					e0[l*sy+o] = En[l];
+					flux[lz].f[l] = Fn[l];
+				}
+			}
+			continue;
+		}
+		for (unsigned int l=l0; l<l1; ++l)
+		{
+			float* __restrict el = e0 + l*sy;
+			for (unsigned int lz=0; lz<NZ; ++lz)
+			{
+				float& V = el[zo[lz]];
+				float& Fl = flux[lz].f[l];
+				const Coef4& c = tab[ix[lz]];
+				if ((HOOK==0) || (HOOK==2))
+				{
+					const FDTD_FLOAT c1 = (HOOK==0) ? c.vv.f[l] : c.ii.f[l], c2 = (HOOK==0) ? c.vvfo.f[l] : c.iifo.f[l];
+					const FDTD_FLOAT f_help = c1 * V - c2 * Fl;
+					V = Fl;
+					Fl = f_help;
+				}
+				else
+				{
+					const FDTD_FLOAT c3 = (HOOK==1) ? c.vvfn.f[l] : c.iifn.f[l];
+					const FDTD_FLOAT f_help = Fl;
+					Fl = V;
+					V = f_help + c3 * Fl;
+				}
+			}
+		}
+	}
+}
+#endif
+
+template <int HOOK>
+void Engine_Ext_UPML::BoxHook(unsigned int x0, unsigned int x1, unsigned int y0, unsigned int y1)
+{
+	const unsigned int sx0 = m_Op_UPML->m_StartPos[0], NX = m_Op_UPML->m_numLines[0];
+	const unsigned int sy0 = m_Op_UPML->m_StartPos[1], NY = m_Op_UPML->m_numLines[1];
+	x0 = std::max(x0, sx0);
+	x1 = std::min(x1, sx0+NX);
+	y0 = std::max(y0, sy0);
+	y1 = std::min(y1, sy0+NY);
+	if ((x0>=x1) || (y0>=y1))
+		return;
+	const unsigned int a = y0-sy0, b = y1-sy0; // the local rows [a, b) of every x-line
+	for (unsigned int lx=x0-sx0; lx<x1-sx0; ++lx)
+	{
+		const unsigned int r = lx*NY;
+		if (m_Vec)
+		{
+			switch (HOOK)
+			{
+			case 0: DoPreVoltageUpdatesRows(r+a, r+b); break;
+			case 1: DoPostVoltageUpdatesRows(r+a, r+b); break;
+			case 2: DoPreCurrentUpdatesRows(r+a, r+b); break;
+			case 3: DoPostCurrentUpdatesRows(r+a, r+b); break;
+			}
+			continue;
+		}
+#ifdef UPML_F4VECTOR
+		if (m_YVec)
+		{
+			// whole groups through YVecRows (a run of them at once), a cut group through YVecPart
+			unsigned int run = a, ly = a;
+			while (ly<b)
+			{
+				const unsigned int g = ly/4, gs = 4*g, ge = std::min(gs+4, NY);
+				const unsigned int end = std::min(b, ge);
+				if ((ly==gs) && (end==ge))
+				{
+					ly = end;
+					continue;
+				}
+				if (run<ly)
+					YVecRows<HOOK>(r+run, r+ly);
+				YVecPart<HOOK>(lx, g, ly-gs, end-gs);
+				ly = run = end;
+			}
+			if (run<ly)
+				YVecRows<HOOK>(r+run, r+ly);
+			continue;
+		}
+#endif
+		switch (HOOK)
+		{
+		case 0: DoPreVoltageUpdatesSSERows(r+a, r+b); break;
+		case 1: DoPostVoltageUpdatesSSERows(r+a, r+b); break;
+		case 2: DoPreCurrentUpdatesSSERows(r+a, r+b); break;
+		case 3: DoPostCurrentUpdatesSSERows(r+a, r+b); break;
+		}
+	}
+}
+
+void Engine_Ext_UPML::DoPreVoltageUpdatesBox(unsigned int x0, unsigned int x1, unsigned int y0, unsigned int y1)
+{
+	BoxHook<0>(x0, x1, y0, y1);
+}
+
+void Engine_Ext_UPML::DoPostVoltageUpdatesBox(unsigned int x0, unsigned int x1, unsigned int y0, unsigned int y1)
+{
+	BoxHook<1>(x0, x1, y0, y1);
+}
+
+void Engine_Ext_UPML::DoPreCurrentUpdatesBox(unsigned int x0, unsigned int x1, unsigned int y0, unsigned int y1)
+{
+	BoxHook<2>(x0, x1, y0, y1);
+}
+
+void Engine_Ext_UPML::DoPostCurrentUpdatesBox(unsigned int x0, unsigned int x1, unsigned int y0, unsigned int y1)
+{
+	BoxHook<3>(x0, x1, y0, y1);
+}
