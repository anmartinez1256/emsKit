+void Engine_Ext_SteadyState::Apply2VoltagesBox(unsigned int x0, unsigned int x1, unsigned int y0, unsigned int y1)
+{
+	if ((x0>=x1) || (y0>=y1))
+		return;
+	const unsigned int TS = m_Eng->GetNumberOfTimesteps();
+	RecordProbesBox(TS, x0, x1, y0, y1);
+	if (!IsEvaluationStep(TS))
+		return;
+	const ArrayLib::ArrayENG<f4vector>& V = *((Engine_sse*)m_Eng)->f4_volt_ptr;
+	const ArrayLib::ArrayENG<f4vector>& I = *((Engine_sse*)m_Eng)->f4_curr_ptr;
+	std::call_once(m_SnapOnce, [&]()   // the same allocation as in Apply2VoltagesLines (one flag: whichever runs first)
+	{
+		m_SnapVolt.Init("SteadyState_volt", {V.extent(1), V.extent(2), V.extent(3)});
+		m_SnapCurr.Init("SteadyState_curr", {I.extent(1), I.extent(2), I.extent(3)});
+	});
+	// the I-J-K-N layout (SetupLines): the y rows [y0, y1) of an x-line are one block of the arrays
+	const size_t line = V.stride(1), row = V.stride(2); // f4vectors per x-line and per y row, all three components
+	for (unsigned int x=x0; x<x1; ++x)
+	{
+		memcpy(m_SnapVolt.data()+x*line+y0*row, V.data()+x*line+y0*row, (y1-y0)*row*sizeof(f4vector));
+		memcpy(m_SnapCurr.data()+x*line+y0*row, I.data()+x*line+y0*row, (y1-y0)*row*sizeof(f4vector));
+	}
+	// the thread that copies the last rows evaluates (the others' copies and records are complete then)
+	const uint64_t n = (uint64_t)(x1-x0)*(y1-y0), all = (uint64_t)m_NX*V.extent(2);
+	if (m_SnapRows.fetch_add(n, std::memory_order_acq_rel)+n!=all)
+		return;
+	m_SnapRows.store(0, std::memory_order_relaxed);
+	unsigned int numNodes[3];
+	m_Eng_Interface->GetFastEnergyNodes(numNodes);
+	EvaluatePeriod(TS, Engine_sse::FastEnergy(m_SnapVolt, m_SnapCurr, numNodes, V.extent(3)));
+}
