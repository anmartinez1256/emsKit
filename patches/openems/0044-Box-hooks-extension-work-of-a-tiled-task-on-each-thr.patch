+const std::vector<unsigned int>& Engine_Ext_Excitation::BoxOrder(const unsigned int* order, unsigned int n0, unsigned int n1, const unsigned int* y_index,
+																 unsigned int y0, unsigned int y1)
+{
+	// one list per thread: the threads of a task call the box hooks at the same time
+	static thread_local std::vector<unsigned int> list;
+	list.clear();
+	for (unsigned int k=n0; k<n1; ++k)
+		if ((y_index[order[k]]>=y0) && (y_index[order[k]]<y1))
+			list.push_back(order[k]);
+	return list;
+}
+
+void Engine_Ext_Excitation::Apply2VoltagesBox(unsigned int x0, unsigned int x1, unsigned int y0, unsigned int y1)
+{
+	const unsigned int n0 = std::lower_bound(m_VoltX.begin(), m_VoltX.end(), x0) - m_VoltX.begin();
+	const unsigned int n1 = std::lower_bound(m_VoltX.begin(), m_VoltX.end(), x1) - m_VoltX.begin();
+	if ((n0>=n1) || (y0>=y1))
+		return;
+	const std::vector<unsigned int>& list = BoxOrder(m_VoltOrder.data(), n0, n1, m_Op_Exc->Volt_index[1], y0, y1);
+	if (!list.empty())
+		Apply2VoltagesImpl<Engine_sse>((Engine_sse*)m_Eng, list.data(), 0, list.size());
+}
+
+void Engine_Ext_Excitation::Apply2CurrentBox(unsigned int x0, unsigned int x1, unsigned int y0, unsigned int y1)
+{
+	const unsigned int n0 = std::lower_bound(m_CurrX.begin(), m_CurrX.end(), x0) - m_CurrX.begin();
+	const unsigned int n1 = std::lower_bound(m_CurrX.begin(), m_CurrX.end(), x1) - m_CurrX.begin();
+	if ((n0>=n1) || (y0>=y1))
+		return;
+	const std::vector<unsigned int>& list = BoxOrder(m_CurrOrder.data(), n0, n1, m_Op_Exc->Curr_index[1], y0, y1);
+	if (!list.empty())
+		Apply2CurrentImpl<Engine_sse>((Engine_sse*)m_Eng, list.data(), 0, list.size());
+}
