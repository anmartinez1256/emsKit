+}
+
+void Engine_Ext_LorentzMaterial::Apply2CurrentLines(unsigned int x0, unsigned int x1)
+{
+	if (m_PI.on)
+		return ApplyPacked((float*)((Engine_sse*)m_Eng)->f4_curr_ptr->data(), m_PI, x0, x1);
+	Engine_Ext_Dispersive::Apply2CurrentLines(x0, x1);
+}
