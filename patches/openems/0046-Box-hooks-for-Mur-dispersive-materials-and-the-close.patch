+// The box hooks. Why this is the order of the line hooks for every cell, with the y-bands of a Y_WRAP sweep (a row may
+// only be read after its final write of the step and before its next one):
+// - row 0 of the voltages is written here (copy of row NY-2); it is read by the currents of row 0 (x and x-1) and by the
+//   Post/Apply hooks of later extensions on row 0. The engine runs row 0 (update and hooks) in the last band, in a box
+//   called before the box with NY-2 extension by extension: the copy reads NY-2 after its update and after the Post hooks
+//   of the extensions before this one (the UPML writes there), before those after it, as in a whole plane; the currents
+//   of row 0 come after it in that band. The update of row 0 itself (later overwritten) reads only the old currents of
+//   row 0, which stay old until then.
+// - row NY-2 of the currents is written here (copy of row 0) when the box holds NY-2; the box with row 0 ran first in the
+//   same band (update and the Post hooks before this one), as in a whole plane. NY-2 is read by the voltages of NY-2 and
+//   NY-1 only in the next timestep.
+// - r=0 sums the old alpha currents of every row of x-line 0 and writes every row: whole planes only, which the engine
+//   gives the first block of the domain in Y_WRAP mode.
+// The tiled sweep's box mode (threads on disjoint y ranges at once) is refused for Y_WRAP: the copies cross ranges.
+template <typename EngType>
+void Engine_Ext_Cylinder::DoPostVoltageUpdatesBoxImpl(EngType* eng, unsigned int x0, unsigned int x1, unsigned int y0, unsigned int y1)
+{
+	if (CC_closedAlpha==false) return;
+	if (x1>numLines[0])
+		x1 = numLines[0];
+	if ((x0>=x1) || (y0>=y1))
+		return;
+
+	if (CC_R0_included && (x0==0))
+	{
+		if ((y0!=0) || (y1<numLines[1]))
+		{
+			static bool told = false;
+			if (!told)
+				std::cerr << "Engine_Ext_Cylinder: error, the r=0 hook was called for the y lines " << y0 << " .. " << y1
+						  << " only (it needs all of them); the result is wrong" << std::endl;
+			told = true;
+		}
+		else
+		{
+			unsigned int pos[3];
+			pos[0] = 0;
+			FDTD_FLOAT volt=0;
+			for (pos[2]=0; pos[2]<numLines[2]; ++pos[2])
+			{
+				volt =eng->EngType::GetVolt(2,0,0,pos[2])*cyl_Op->vv_R0[pos[2]];
+				for (pos[1]=0; pos[1]<numLines[1]-1; ++pos[1])
+					volt +=cyl_Op->vi_R0[pos[2]] *  eng->EngType::GetCurr(1,0,pos[1],pos[2]);
+				eng->EngType::SetVolt(2,0,0,pos[2], volt);
+			}
+
+			for (pos[1]=0; pos[1]<numLines[1]; ++pos[1])
+			{
+				for (pos[2]=0; pos[2]<numLines[2]; ++pos[2])
+				{
+					eng->EngType::SetVolt(1,0,pos[1],pos[2], 0); //no voltage in alpha-direction at r=0
+					eng->EngType::SetVolt(2,0,pos[1],pos[2], eng->EngType::GetVolt(2,0,0,pos[2]) );
+				}
+			}
+		}
+	}
+
+	// close alpha: row 0 of the box from the last alpha-plane
+	if (y0!=0)
+		return;
+	unsigned int pos[3];
+	unsigned int last_A_Line = numLines[1]-2;
+	for (pos[0]=x0; pos[0]<x1; ++pos[0])
+	{
+		for (pos[2]=0; pos[2]<numLines[2]; ++pos[2])
+		{
+			eng->EngType::SetVolt(0,pos[0],0,pos[2], eng->EngType::GetVolt(0,pos[0],last_A_Line,pos[2]) );
+			eng->EngType::SetVolt(2,pos[0],0,pos[2], eng->EngType::GetVolt(2,pos[0],last_A_Line,pos[2]) );
+		}
+	}
+}
+
+template <typename EngType>
+void Engine_Ext_Cylinder::DoPostCurrentUpdatesBoxImpl(EngType* eng, unsigned int x0, unsigned int x1, unsigned int y0, unsigned int y1)
+{
+	if (CC_closedAlpha==false) return;
+	if (x1>numLines[0]-1)
+		x1 = numLines[0]-1;
+	unsigned int last_A_Line = numLines[1]-2;
+	// close alpha: row NY-2 of the box from the first alpha-plane
+	if ((last_A_Line<y0) || (last_A_Line>=y1))
+		return;
+	unsigned int pos[3];
+	for (pos[0]=x0; pos[0]<x1; ++pos[0])
+	{
+		for (pos[2]=0; pos[2]<numLines[2]-1; ++pos[2])
+		{
+			eng->EngType::SetCurr(0,pos[0],last_A_Line,pos[2], eng->EngType::GetCurr(0,pos[0],0,pos[2]) );
+			eng->EngType::SetCurr(2,pos[0],last_A_Line,pos[2], eng->EngType::GetCurr(2,pos[0],0,pos[2]) );
+		}
+	}
+}
