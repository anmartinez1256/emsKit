+			const unsigned int y0 = k ? b0 : a0, y1 = k ? b1 : a1;
+			switch (group)
+			{
+			case 0: exts[n]->DoPreVoltageUpdatesBox(x0, x1, y0, y1); break;
+			case 1: exts[n]->DoPostVoltageUpdatesBox(x0, x1, y0, y1); break;
+			case 2: exts[n]->Apply2VoltagesBox(x0, x1, y0, y1); break;
+			case 3: exts[n]->DoPreCurrentUpdatesBox(x0, x1, y0, y1); break;
+			case 4: exts[n]->DoPostCurrentUpdatesBox(x0, x1, y0, y1); break;
