+	if (y0>=y1) return;
+	MUR_LINE_DATA
+	const ptrdiff_t oS = m_OffsetShift/4;
+	x1 = std::min<unsigned int>(x1, m_VecStart.size()-1);
+	for (unsigned int x=x0; x<x1; ++x)
+	{
+		unsigned int g0, g1, k0, k1;
+		BoxRange(x, y0, y1, g0, g1, k0, k1);
+		for (unsigned int g=g0; g<g1; ++g)
+		{
+			const f4vector* e = E4 + m_VecIndex[g];
+			m_VecP[g].v  += m_VecCoeffP[g].v  * e[oP+oS].v;
+			m_VecPP[g].v += m_VecCoeffPP[g].v * e[oPP+oS].v;
