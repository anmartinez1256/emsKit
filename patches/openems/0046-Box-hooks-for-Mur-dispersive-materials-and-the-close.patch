+void Engine_Ext_Mur_ABC::DoPreVoltageUpdatesBox(unsigned int x0, unsigned int x1, unsigned int y0, unsigned int y1)
+{
+	if (IsActive()==false) return;
+	if (y0>=y1) return;
+	MUR_LINE_DATA
+	const ptrdiff_t oS = m_OffsetShift/4;
+	x1 = std::min<unsigned int>(x1, m_VecStart.size()-1);
+	for (unsigned int x=x0; x<x1; ++x)
+	{
+		unsigned int g0, g1, k0, k1;
+		BoxRange(x, y0, y1, g0, g1, k0, k1);
+		for (unsigned int g=g0; g<g1; ++g)
+		{
+			const f4vector* e = E4 + m_VecIndex[g];
+			m_VecP[g].v  = e[oP+oS].v  - m_VecCoeffP[g].v  * e[oP].v;
+			m_VecPP[g].v = e[oPP+oS].v - m_VecCoeffPP[g].v * e[oPP].v;
+		}
+		for (unsigned int k=k0; k<k1; ++k)
+			d.Pre(k);
+	}
+}
