+void Engine_Multithread::SetupYCuts()
+{
+	const unsigned int NY = numLines[1];
+	m_YWrap = false;
+	std::vector<unsigned int> rows;
+	for (size_t k=0; k<m_Eng_exts.size(); ++k)
+	{
+		const unsigned int used = m_Eng_exts.at(k)->GetUsedHooks();
+		if ((used!=Engine_Extension::LEGACY_HOOKS) && (used & Engine_Extension::BOX_HOOKS) && (used & Engine_Extension::Y_WRAP))
+			m_YWrap = true;
+		m_Eng_exts.at(k)->GetCoupledRows(rows);
+	}
+	// ok[i]: a cut at i (between the rows i-1 and i) separates no coupled pair; a closed y direction keeps 0|1 and
+	// NY-2|NY-1 too (its last band must hold NY-2, and its first band a row besides row 0)
+	std::vector<bool> ok(NY+1, true);
+	for (size_t n=0; n<rows.size(); ++n)
+		if (rows[n]+1<NY)
+			ok[rows[n]+1] = false;
+	if (m_YWrap && (NY>=2))
+		ok[1] = ok[NY-1] = false;
+	ok[0] = ok[NY] = true;
+	m_YCut.assign(NY+1, 0);
+	unsigned int below = 0;
+	for (unsigned int i=0; i<=NY; ++i)
+	{
+		if (ok[i])
+			below = i;
+		m_YCut[i] = below;
+	}
+	unsigned int above = NY;
+	for (unsigned int i=NY; i>=1; --i)
+	{
+		if (ok[i])
+			above = i;
+		if (m_YCut[i]==0)
+			m_YCut[i] = above;
+	}
+}
