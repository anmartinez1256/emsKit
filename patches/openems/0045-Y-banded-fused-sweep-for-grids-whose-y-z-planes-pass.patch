+void Engine_Multithread::FusedBands(unsigned int b0, unsigned int bl, unsigned int start)
+{
+	// The order of the fused sweep with the y direction cut into bands: the voltages of a cell (x, y) need the old currents
+	// of (x, y), (x-1, y) and (x, y-1), the currents of (x, y) the final voltages of (x, y), (x+1, y) and (x, y+1). The
+	// voltages of the band [y0, y1) on the block [x0, x1) are followed by the currents of the lines behind the block,
+	// [x0-1, x1-1) (from x0 at the start of the slab), on the rows behind the band, [y0-1, y1-1) (from 0 in the first band,
+	// up to NY in the last one, whose last row the update leaves alone, as in whole planes). In the order (band, block,
+	// voltages before currents) the currents of (x, y) belong to (band of y+1, block of x+1): after the final voltages of
+	// (x, y), (x+1, y) and (x, y+1), which are also the only voltages that read the old currents of (x, y). So every cell
+	// gets the operands of the unfused update; the z direction stays inside a row. After the last band the currents of the
+	// lines [start, m_Blocks[bl]-1) are done on all rows, exactly what the sweep in whole planes leaves when it reaches the
+	// block bl. All hooks touch their own cells only (box hooks), in the order Pre, update, Post, Apply of every cell.
+	const unsigned int NY = numLines[1], H = m_YBand;
+	for (unsigned int y0=0; y0<NY; y0+=H)
+	{
+		const unsigned int y1 = std::min(NY, y0+H);   // H < NY: no wrap-around
+		const unsigned int yc0 = (y0==0) ? 0 : y0-1;
+		const unsigned int yc1 = (y1==NY) ? NY : y1-1;
+		for (unsigned int b=b0; b<bl; ++b)
+		{
+			const unsigned int x0 = m_Blocks[b], x1 = m_Blocks[b+1];
+			RunBoxHooks(0, x0, x1, y0, y1);
+			UpdateVoltagesY(x0, x1-x0, y0, y1);
+			RunBoxHooks(1, x0, x1, y0, y1);
+			RunBoxHooks(2, x0, x1, y0, y1);
+			const unsigned int xc0 = (x0==start) ? x0 : x0-1, xc1 = x1-1;
+			if ((xc0<xc1) && (yc0<yc1))
+			{
+				RunBoxHooks(3, xc0, xc1, yc0, yc1);
+				UpdateCurrentsY(xc0, xc1-xc0, yc0, yc1);
+				RunBoxHooks(4, xc0, xc1, yc0, yc1);
+				RunBoxHooks(5, xc0, xc1, yc0, yc1);
+			}
+		}
+	}
 }
 
