+//! The automatic rule of the y-bands of the fused sweep (OPENEMS_YBAND unset or "auto"), all its constants in one place:
+//! - a thread reuses about four y-z planes of one field (three float components each): the voltages and currents of the
+//!   line it updates and of the line before it;
+//! - bands are used only when those four planes do not fit the thread's share of its L2 cache (YBandCacheShare);
+//! - a band then holds the y lines whose four band-planes take about half of that share (the rest is left for the
+//!   coefficient tables, the operator indices and the extensions' data), at least YBAND_MIN_LINES;
+//! - and none when such bands would be half the y lines or more (two bands per plane gain nothing).
+static const unsigned int YBAND_PLANES = 4;
+static const double YBAND_CACHE_FRACTION = 0.5;
+static const unsigned int YBAND_MIN_LINES = 4;
+
+//! A thread's share of its L2 cache for the y-bands (bytes; 0 when unknown): OPENEMS_YBAND_CACHE=<MiB per thread>; on Apple
+//! the L2 cache of a cluster divided by the cores sharing it (hw.perflevelN.l2cachesize / hw.perflevelN.cpusperl2), the
+//! smallest one of the performance levels the threads occupy (level 0 first, then 1, ..: level 0 alone when the threads
+//! fit its cores); elsewhere (or when those are unknown) the cache of TileCacheBytes() divided by the threads.
+static double YBandCacheShare(unsigned int numThreads)
+{
+	const char* env = getenv("OPENEMS_YBAND_CACHE");
+	if (env && *env && (atof(env)>0))
+		return atof(env)*1048576.0;
+	numThreads = std::max(1u, numThreads);
+#ifdef __APPLE__
+	int levels = 0;
+	size_t len = sizeof(levels);
+	if ((sysctlbyname("hw.nperflevels", &levels, &len, NULL, 0)==0) && (levels>=1))
+	{
+		double share = 0;
+		unsigned int cores = 0;
+		bool ok = true;
+		for (int k=0; (k<levels) && ((k==0) || (cores<numThreads)); ++k)
+		{
+			char key[64];
+			int64_t l2 = 0;   // the kernel fills 4 or 8 of these bytes
+			int per = 0, phys = 0;
+			snprintf(key, sizeof(key), "hw.perflevel%d.l2cachesize", k);
+			len = sizeof(l2);
+			ok = ok && (sysctlbyname(key, &l2, &len, NULL, 0)==0) && (l2>0);
+			snprintf(key, sizeof(key), "hw.perflevel%d.cpusperl2", k);
+			len = sizeof(per);
+			ok = ok && (sysctlbyname(key, &per, &len, NULL, 0)==0) && (per>0);
+			snprintf(key, sizeof(key), "hw.perflevel%d.physicalcpu", k);
+			len = sizeof(phys);
+			ok = ok && (sysctlbyname(key, &phys, &len, NULL, 0)==0) && (phys>0);
+			if (!ok)
+				break;
+			const double s = (double)l2/per;
+			share = (k==0) ? s : std::min(share, s);
+			cores += phys;
+		}
+		if (ok && (share>0))
+			return share;
+	}
+#endif
+	const size_t cache = TileCacheBytes();
+	return (cache>0) ? (double)cache/numThreads : 0;
+}
