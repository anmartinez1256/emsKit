+//! The box hooks of extensions with a list of points (excitation, lumped elements): the points sorted by (x, y) once, so that
+//! a call for the box [x0, x1) x [y0, y1) finds its points by binary search and costs what lies in the box, not the list.
+namespace BoxRuns
+{
+	inline uint64_t Key(unsigned int x, unsigned int y) {return ((uint64_t)x<<32) | y;}
+
+	//! order = the points 0 .. count-1 sorted by (x[n], y[n]), stable (points on one cell keep their order), key = their keys
+	inline void Build(const unsigned int* x, const unsigned int* y, unsigned int count, std::vector<unsigned int>& order, std::vector<uint64_t>& key)
+	{
+		order.resize(count);
+		for (unsigned int n=0; n<count; ++n)
+			order[n] = n;
+		std::stable_sort(order.begin(), order.end(), [x, y](unsigned int a, unsigned int b) {return Key(x[a], y[a])<Key(x[b], y[b]);});
+		key.resize(count);
+		for (unsigned int n=0; n<count; ++n)
+			key[n] = Key(x[order[n]], y[order[n]]);
+	}
+
+	//! f(k0, k1) for every x-line of the box that has points with y in [y0, y1): the positions [k0, k1) of the sorted list,
+	//! in ascending x (one call per x-line: the points of one cell are always in one call, in their order)
+	template <class F>
+	void ForEach(const std::vector<uint64_t>& key, unsigned int x0, unsigned int x1, unsigned int y0, unsigned int y1, F f)
+	{
+		if ((x0>=x1) || (y0>=y1))
+			return;
+		std::vector<uint64_t>::const_iterator it = std::lower_bound(key.begin(), key.end(), Key(x0, 0));
+		const std::vector<uint64_t>::const_iterator end = std::lower_bound(it, key.end(), Key(x1, 0));
+		while (it<end)
+		{
+			const unsigned int x = (unsigned int)((*it)>>32);
+			const std::vector<uint64_t>::const_iterator a = std::lower_bound(it, end, Key(x, y0));
+			const std::vector<uint64_t>::const_iterator b = std::lower_bound(a, end, Key(x, y1));
+			if (a<b)
+				f((unsigned int)(a-key.begin()), (unsigned int)(b-key.begin()));
+			it = std::lower_bound(b, end, Key(x+1, 0));
+		}
+	}
+}
+
+#endif // ENGINE_EXT_BOXRUNS_H
