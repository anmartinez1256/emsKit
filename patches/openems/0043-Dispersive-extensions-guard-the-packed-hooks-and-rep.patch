diff --git a/FDTD/extensions/engine_ext_dispersive.cpp b/FDTD/extensions/engine_ext_dispersive.cpp
index 44cfb7b..e2e6a15 100644
--- a/FDTD/extensions/engine_ext_dispersive.cpp
