@@ -169,6 +169,36 @@ uint64_t Engine_Ext_Dispersive::FieldBytes() const
 	return 2*(uint64_t)eng->f4_volt_ptr->size()*sizeof(f4vector);
 }
 
+uint64_t Engine_Ext_Dispersive::PackedBytesOfOthers() const
+{
+	uint64_t sum = 0;
+	if (!m_Eng)
+		return 0;
+	for (size_t n=0; n<m_Eng->GetExtensionCount(); ++n)
+	{
+		const Engine_Ext_Dispersive* e = dynamic_cast<const Engine_Ext_Dispersive*>(m_Eng->GetExtension(n));
+		if (e && (e!=this))
+			sum += e->PackedBytes();
+	}
+	return sum;
+}
+
+bool Engine_Ext_Dispersive::PackedOff()
+{
+	const char* env = getenv("OPENEMS_ADE_PACKED");
+	return env && *env && (atoi(env)==0);
+}
+
+void Engine_Ext_Dispersive::ReportPackRefusal(PackRefusal r, const char* what, uint64_t need, uint64_t used) const
+{
+	if ((r==PACK_OFF) && (g_settings.GetVerboseLevel()>1))
+		std::cout << GetExtensionName() << ": ADE packing not used" << what << " (OPENEMS_ADE_PACKED=0)" << std::endl;
+	else if (((r==PACK_LIMIT) || (r==PACK_ALLOC)) && (g_settings.GetVerboseLevel()>0))
+		std::cout << GetExtensionName() << ": ADE packing not used" << what << " (" << (r==PACK_LIMIT ? "memory limit" : "allocation failed")
+				  << "): would need " << need << " bytes, limit " << 2*FieldBytes() << " bytes (twice the field arrays), "
+				  << used << " bytes already packed in this engine" << std::endl;
+}
+
 void Engine_Ext_Dispersive::ClearGroups()
 {
 	std::vector<unsigned int>().swap(m_GroupX);
diff --git a/FDTD/extensions/engine_ext_dispersive.h b/FDTD/extensions/engine_ext_dispersive.h
index b79af78..ba5e8ef 100644
--- a/FDTD/extensions/engine_ext_dispersive.h
+++ b/FDTD/extensions/engine_ext_dispersive.h
@@ -85,6 +85,18 @@ protected:
 	std::vector<unsigned int> m_GroupFi;     //!< [12*g+4*n+l]: float index of component n of lane l (unused lanes: lane 0's)
 	//! the bytes of the engine's voltage and current arrays (the limit for packed copies: twice this)
 	uint64_t FieldBytes() const;
+	//! Packed blocks need the GCC/clang vector extensions (v4sf, Load4/Store4); other compilers never build them.
+	//! The limit counts per engine: the packed blocks of all dispersive extensions of one engine together stay
+	//! within twice the field bytes (summed over the extensions of m_Eng, so every engine starts at zero).
+	enum PackRefusal {PACK_OK=0, PACK_NOT_ELIGIBLE, PACK_OFF, PACK_LIMIT, PACK_ALLOC};
+	//! the bytes of this extension's packed blocks
+	virtual uint64_t PackedBytes() const {return 0;}
+	//! the bytes of the packed blocks of the other dispersive extensions of this engine
+	uint64_t PackedBytesOfOthers() const;
+	//! OPENEMS_ADE_PACKED=0
+	static bool PackedOff();
+	//! the line for packing not used: OPENEMS_ADE_PACKED=0 at verbose > 1, memory limit / failed allocation at verbose >= 1
+	void ReportPackRefusal(PackRefusal r, const char* what, uint64_t need, uint64_t used) const;
 	bool AnyVoltADE() const;
 	bool AnyCurrADE() const;
 
