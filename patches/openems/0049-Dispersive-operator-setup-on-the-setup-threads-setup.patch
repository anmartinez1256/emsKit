 //#include "operator.h"
 #include "operator_extension.h"
 #include "vector"
+#include <cstddef>
+#include <cstring>
+#include <functional>
+#include "tools/setup_memory.h"
+
+class CSPrimitives;
+class CSProperties;
+
+//! Values one setup thread collects during a dispersive BuildExtension scan, in blocks of a fixed size: growing never copies
+//! (no doubled buffers that stay resident), at most one block is partly filled; clear() frees the blocks (to the OS on
+//! macOS, see setup_memory.h).
+template <typename T> class DispersiveSetupList
+{
+public:
+	DispersiveSetupList() : m_size(0) {}
+	DispersiveSetupList(DispersiveSetupList&& other) : m_blocks(std::move(other.m_blocks)), m_size(other.m_size) {other.m_size = 0;}
+	DispersiveSetupList(const DispersiveSetupList&) = delete;
+	DispersiveSetupList& operator=(const DispersiveSetupList&) = delete;
+	~DispersiveSetupList() {clear();}
+	void push_back(T value)
+	{
+		const size_t o = m_size % Block();
+		if (o==0)
+			m_blocks.push_back(SetupAlloc<T>(Block()));
+		m_blocks.back()[o] = value;
+		++m_size;
+	}
+	size_t size() const {return m_size;}
+	//! copies the entries [begin, end) to dst
+	void CopyTo(size_t begin, size_t end, T* dst) const
+	{
+		while (begin<end)
+		{
+			const size_t o = begin % Block();
+			const size_t n = (Block()-o < end-begin) ? Block()-o : end-begin;
+			std::memcpy(dst, m_blocks[begin/Block()]+o, n*sizeof(T));
+			dst += n;
+			begin += n;
+		}
+	}
+	void clear()
+	{
+		for (size_t i=0; i<m_blocks.size(); ++i)
+			SetupFree(m_blocks[i]);
+		std::vector<T*>().swap(m_blocks);
+		m_size = 0;
+	}
+private:
+	static size_t Block() {return 65536;}
+	std::vector<T*> m_blocks;
+	size_t m_size;
+};
 
