+
+unsigned int Operator_Ext_Dispersive::SetupScanThreads(unsigned int nx) const
+{
+	return std::max(1u, std::min(m_Op->GetNumSetupThreads(), nx));
+}
+
+void Operator_Ext_Dispersive::SetupScanLines(unsigned int nx, unsigned int threads, std::vector<unsigned int>& line_thread,
+											 const std::function<void(unsigned int thread, unsigned int x)>& scan)
+{
+	line_thread.assign(nx, 0);
+	std::atomic<unsigned int> next(0);
+	auto job = [&](unsigned int t)
+	{
+		for (unsigned int x=next.fetch_add(1); x<nx; x=next.fetch_add(1))
+		{
+			line_thread[x] = t;
+			scan(t, x);
+		}
+	};
+	std::vector<std::thread> pool;
+	for (unsigned int t=1; t<threads; ++t)
+		pool.emplace_back(job, t);
+	job(0);
+	for (size_t t=0; t<pool.size(); ++t)
+		pool[t].join();
+}
+
+bool Operator_Ext_Dispersive::SetupSkipColumn(const std::vector<CSPrimitives*>& vPrims, bool (*want)(CSProperties* prop))
+{
+	for (size_t p=0; p<vPrims.size(); ++p)
+	{
+		CSProperties* prop = vPrims[p]->GetProperty();
+		if ((prop==NULL) || want(prop) || !vPrims[p]->GetPrimitiveUsed())
+			return false;
+	}
+	return true;
+}
