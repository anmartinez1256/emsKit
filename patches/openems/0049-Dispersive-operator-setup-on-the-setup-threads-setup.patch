+
+bool Engine_Ext_Dispersive::FirstComponentsUnique(const std::vector<unsigned int>& fi)
+{
+	// true when no float index fi[3k] appears twice; a bit per float up to the largest index when that costs at most
+	// a word per position (one pass), else sorted (the same answer either way)
+	const size_t count = fi.size()/3;
+	unsigned int top = 0;
+	for (size_t k=0; k<count; ++k)
+		top = std::max(top, fi[3*k]);
+	const size_t words = (size_t)top/64+1;
+	if ((count>0) && (words<=count))
+	{
+		std::vector<uint64_t> seen(words, 0);
+		for (size_t k=0; k<count; ++k)
+		{
+			const unsigned int f = fi[3*k];
+			const uint64_t bit = 1ull<<(f%64);
+			if (seen[f/64] & bit)
+				return false;
+			seen[f/64] |= bit;
+		}
+		return true;
+	}
+	std::vector<unsigned int> f(count);
+	for (size_t k=0; k<count; ++k)
 		f[k] = fi[3*k];
 	std::sort(f.begin(), f.end());
 	return std::adjacent_find(f.begin(), f.end())==f.end();
