+*	GNU General Public License for more details.
+*
+*	You should have received a copy of the GNU General Public License
+*	along with this program.  If not, see <http://www.gnu.org/licenses/>.
+*/
+
+#ifndef SETUP_MEMORY_H
+#define SETUP_MEMORY_H
+
+// Large work arrays of the setup that are freed again before the run (the EC arrays, the dispersive scan lists).
+// On macOS a freed malloc block of this size stays resident and is reused only for a block of about the same size, so
+// every later allocation of the setup and the engine lands on top of it and the process' peak memory grows by the whole
+// array; mapped from the OS directly, freeing gives the memory back. Elsewhere: plain new[]/delete[].
+
+#include <cstddef>
+#include <new>
+#if defined(__APPLE__)
+#include <sys/mman.h>
+#endif
+
+// bytes in front of an array of SetupAlloc(): the mapping's size (one cache line, so the array stays cache-line aligned)
+static const size_t SETUP_ALLOC_HEADER = 128;
+
+//! count elements of T (contents undefined; on macOS zero pages), freed with SetupFree()
+template <typename T> T* SetupAlloc(size_t count)
+{
+#if defined(__APPLE__)
+	const size_t bytes = SETUP_ALLOC_HEADER + count*sizeof(T);
+	void* p = mmap(NULL, bytes, PROT_READ|PROT_WRITE, MAP_ANON|MAP_PRIVATE, -1, 0);
+	if (p==MAP_FAILED)
+		throw std::bad_alloc();
+	*static_cast<size_t*>(p) = bytes;
+	return reinterpret_cast<T*>(static_cast<char*>(p)+SETUP_ALLOC_HEADER);
+#else
+	return new T[count];
+#endif
+}
+
+//! frees an array of SetupAlloc() (NULL: nothing)
+template <typename T> void SetupFree(T* array)
+{
+	if (array==NULL)
+		return;
+#if defined(__APPLE__)
+	char* p = reinterpret_cast<char*>(array) - SETUP_ALLOC_HEADER;
+	munmap(p, *reinterpret_cast<size_t*>(p));
+#else
+	delete[] array;
+#endif
+}
+
+#endif // SETUP_MEMORY_H
