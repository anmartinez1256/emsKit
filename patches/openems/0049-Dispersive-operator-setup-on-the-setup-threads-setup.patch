+*	along with this program.  If not, see <http://www.gnu.org/licenses/>.
+*/
+
+#ifndef SETUP_TIMING_H
+#define SETUP_TIMING_H
+
+// OPENEMS_SETUP_TIMING=1 prints every phase of the setup to stderr, one line a phase:
+//   setup timing: <what> <step>: <wall> s, cpu <cpu> s, rss <now> MiB, peak <peak> MiB
+// wall and cpu (the process, all threads: cpu/wall > 1 is a phase that runs on several threads) since the timer's last
+// lap; rss = the resident memory now, peak = the most it ever was (what a benchmark's maximum RSS reports); on Apple
+// also heap = the bytes malloc has handed out and not got back (freed memory that stays resident counts in rss, not here).
+// Nothing is measured unless the variable is set.
+
+#include <chrono>
+#include <ctime>
+#include <iostream>
+#include <sstream>
+#include <string>
+#include "useful.h"
+#include <cstdint>
+#include <cstddef>
+#if defined(__APPLE__)
+#include <mach/mach.h>
+#include <malloc/malloc.h>
+#endif
+#if defined(__APPLE__) || defined(__unix__)
+#include <sys/resource.h>
+#endif
+#if defined(__linux__)
+#include <fstream>
+#include <unistd.h>
+#endif
+
+struct SetupTimer
+{
+	explicit SetupTimer(const std::string& what) : m_what(what)
+	{
+		if (Enabled())
+		{
+			m_t0 = std::chrono::steady_clock::now();
+			m_c0 = CpuSeconds();
+		}
+	}
+	static bool Enabled() { static const bool on = EnvFlag("OPENEMS_SETUP_TIMING"); return on; }
+	//! the CPU time of the process (all threads), s
+	static double CpuSeconds()
+	{
+#if defined(__APPLE__) || defined(__unix__)
+		struct rusage ru;
+		if (getrusage(RUSAGE_SELF, &ru)==0)
+			return ru.ru_utime.tv_sec + ru.ru_stime.tv_sec + 1e-6*(ru.ru_utime.tv_usec + ru.ru_stime.tv_usec);
+#endif
+		return (double)std::clock()/CLOCKS_PER_SEC;
+	}
+	//! the resident memory now and its peak, MiB (0 where unknown)
+	static void Memory(double& now, double& peak)
+	{
+		now = peak = 0;
+#if defined(__APPLE__)
+		mach_task_basic_info_data_t info;
+		mach_msg_type_number_t count = MACH_TASK_BASIC_INFO_COUNT;
+		if (task_info(mach_task_self(), MACH_TASK_BASIC_INFO, (task_info_t)&info, &count)==KERN_SUCCESS)
+		{
+			now = info.resident_size/1048576.0;
+			peak = info.resident_size_max/1048576.0;
+		}
+#elif defined(__linux__)
+		std::ifstream statm("/proc/self/statm");
+		unsigned long long size = 0, res = 0;
+		if (statm >> size >> res)
+			now = (double)res*sysconf(_SC_PAGESIZE)/1048576.0;
+		struct rusage ru;
+		if (getrusage(RUSAGE_SELF, &ru)==0)
+			peak = ru.ru_maxrss/1024.0;
+#endif
+	}
+	void Lap(const std::string& step)
+	{
+		if (!Enabled()) return;
+		const std::chrono::steady_clock::time_point t = std::chrono::steady_clock::now();
+		const double c = CpuSeconds();
+		double now, peak;
+		Memory(now, peak);
+		std::ostringstream o;
+		o.setf(std::ios::fixed);
+		o.precision(3);
+		o << "setup timing: " << m_what << " " << step << ": " << std::chrono::duration<double>(t-m_t0).count() << " s, cpu " << c-m_c0 << " s";
+		o.precision(0);
+		o << ", rss " << now << " MiB, peak " << peak << " MiB";
+#if defined(__APPLE__)
+		malloc_statistics_t st;
+		malloc_zone_statistics(NULL, &st);
+		o << ", heap " << st.size_in_use/1048576.0 << " MiB";
+#endif
+		std::cerr << o.str() << std::endl;
+		m_t0 = t;
+		m_c0 = c;
+	}
+	//! FNV-1a over raw bytes (to compare setup results between builds: same hash, same bytes)
+	static uint64_t Hash(const void* data, size_t bytes, uint64_t h = 1469598103934665603ULL)
+	{
+		const unsigned char* p = static_cast<const unsigned char*>(data);
+		for (size_t i=0; i<bytes; ++i)
+			h = (h ^ p[i])*1099511628211ULL;
+		return h;
+	}
+	//! one line "setup timing: <what>: <text>" (nothing unless enabled)
+	static void Note(const std::string& what, const std::string& text)
+	{
+		if (Enabled())
+			std::cerr << "setup timing: " << what << ": " << text << std::endl;
+	}
+	std::string m_what;
+	std::chrono::steady_clock::time_point m_t0;
+	double m_c0 = 0;
+};
+
+#endif // SETUP_TIMING_H
