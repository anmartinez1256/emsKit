+template <class F> int Engine_Ext_Dispersive::BuildCoefSets(CoefSets& c, unsigned int stride, uint64_t budget, F fill) const
+{
+	c = CoefSets();
+	c.stride = stride;
+	const size_t groups = m_GroupX.size();
+	const char* env = getenv("OPENEMS_ADE_COEF");
+	const std::string mode = env ? env : "";
+	// a table pays while it has at most a quarter as many sets as there are groups
+	const size_t maxSets = (mode=="table" || mode=="table32") ? groups : groups/4;
+	bool table = (mode!="group") && (maxSets>0);
+	try
+	{
+		if (table)
+		{
+			std::vector<float> rec(stride);
+			std::vector<uint32_t> id(groups);
+			std::unordered_map<uint64_t, uint32_t> head;  // hash -> newest set with that hash
+			std::vector<uint32_t> next;                   // [set]: older set with the same hash, ~0u at the end
+			for (size_t g=0; g<groups; ++g)
+			{
+				std::fill(rec.begin(), rec.end(), 0.0f);
+				fill(g, rec.data());
+				uint64_t h = 1469598103934665603ull;      // FNV-1a over the bits
+				for (unsigned int j=0; j<stride; ++j)
+				{
+					uint32_t w;
+					memcpy(&w, &rec[j], sizeof(w));
+					h = (h^w)*1099511628211ull;
+				}
+				std::unordered_map<uint64_t, uint32_t>::iterator it = head.find(h);
+				uint32_t s = ~0u;
+				if (it!=head.end())
+					for (uint32_t t=it->second; t!=~0u; t=next[t])
+						if (memcmp(&c.sets[(size_t)t*stride], rec.data(), stride*sizeof(float))==0)
+						{
+							s = t;
+							break;
+						}
+				if (s==~0u)
+				{
+					if (next.size()>=maxSets)
+					{
+						table = false;
+						break;
+					}
+					s = (uint32_t)next.size();
+					next.push_back(it!=head.end() ? it->second : ~0u);
+					head[h] = s;
+					c.sets.insert(c.sets.end(), rec.begin(), rec.end());
+				}
+				id[g] = s;
+			}
+			if (table)
+			{
+				if ((next.size()<=65536) && (mode!="table32"))
+				{
+					c.idx16.resize(groups);
+					for (size_t g=0; g<groups; ++g)
+						c.idx16[g] = (uint16_t)id[g];
+				}
+				else
+					c.idx32.swap(id);
+				std::vector<float>(c.sets).swap(c.sets);
+			}
+		}
+		if (!table)
+		{
+			std::vector<float>().swap(c.sets);
+			if ((uint64_t)groups*stride*sizeof(float) > budget)
+			{
+				c = CoefSets();
+				return PACK_LIMIT;
+			}
+			c.sets.assign((size_t)groups*stride, 0.0f);
+			for (size_t g=0; g<groups; ++g)
+				fill(g, &c.sets[g*stride]);
+		}
+	}
+	catch (std::bad_alloc&)
+	{
+		c = CoefSets();
+		return PACK_ALLOC;
+	}
+	if (c.Bytes() > budget)
+	{
+		c = CoefSets();
+		return PACK_LIMIT;
+	}
+	return PACK_OK;
+}
